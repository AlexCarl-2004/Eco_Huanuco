# Copie este archivo como .env y ajuste los valores.
# Si no existe .env, el proyecto funciona con SQLite y los valores por defecto.

# --- Django ---
DJANGO_SECRET_KEY=cambie-esta-clave-por-una-larga-y-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Base de datos ---
# sqlite (por defecto) o mysql
DB_ENGINE=sqlite
DB_NAME=ecohuanuco
DB_USER=ecohuanuco
DB_PASSWORD=ecohuanuco
DB_HOST=127.0.0.1
DB_PORT=3306

# --- Frontend Angular permitido (CORS) ---
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# --- Broker MQTT (Mosquitto) ---
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=ecohuanuco/v1
MQTT_QOS=1

# --- Rutas ---
RUTAS_UMBRAL_PCT=75
RUTAS_TIEMPO_SERVICIO_MIN=3
